{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  // Repo-owned wrapper. Extends the canonical strict base synced from
  // davidvornholt/standards. Add project-specific overrides here; never edit
  // biome.base.jsonc locally.
  "extends": ["./biome.base.jsonc"],
  "files": {
    // Claude workflow scripts are a sandboxed DSL dialect (ambient
    // orchestration globals, top-level return) that Biome's ES module
    // parser rejects; the Workflow harness validates them at run time.
    // Claude agent worktrees are full checkouts with their own root
    // biome.jsonc; nested biome.json(c) files are scanner-priority special
    // files, so only force-ignore (`!!`) guarantees they are never discovered
    // as nested roots.
    // routeTree.gen.ts is generated by TanStack Router on every dev/build
    // run and explicitly asks to be excluded from linting and formatting;
    // it cannot conform to the repository style.
    // packages/db/drizzle is drizzle-kit's generated migration output (SQL +
    // meta snapshots); drizzle-kit rewrites it on every `db:generate`, so
    // formatting it would just fight the generator.
    "includes": [
      "**",
      "!.claude/workflows",
      "!!.claude/worktrees",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/db/drizzle"
    ]
  },
  "overrides": [
    {
      // These framework boundaries require default exports as part of their
      // file-based configuration contracts (Vite, Playwright, Drizzle Kit).
      "includes": [
        "apps/web/vite.config.ts",
        "apps/web/playwright.config.ts",
        "packages/db/drizzle.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Designated environment boundary: env.ts reads process.env exactly once
      // and validates it. The UPPER_SNAKE keys are the dotenv wire format, not
      // naming choices.
      "includes": ["apps/web/src/shared/env.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // drizzle.config.ts runs in drizzle-kit's CLI context (also inside the
      // migration container, where only DATABASE_URL exists) and must not pull
      // the full app env. Its DATABASE_URL read is migrate-runtime-only, never
      // a cached Turbo task input, so it does not belong in turbo.json env
      // declarations.
      "includes": ["packages/db/drizzle.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // TanStack Start server routes: handler keys are the HTTP verbs
      // (GET/POST) and the splat route file must be named `$.ts` — both are
      // framework contracts, not naming choices.
      "includes": ["apps/web/src/routes/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      // The TanStack Start document shell renders the literal <head> element;
      // noHeadElement is a Next.js-domain rule and this is not a Next app.
      // Biome's resolver also cannot follow Vite's `?url` asset-query import
      // for the stylesheet; Vite and tsc remain the authoritative resolvers.
      "includes": ["apps/web/src/routes/__root.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "noHeadElement": "off"
          }
        }
      }
    },
    {
      // App- and package-owned operational scripts are Bun boundaries like
      // the canonical root scripts covered by biome.base.jsonc: the `Bun`
      // global comes from the Bun runtime (typed via @types/bun). These
      // scripts are launched directly (`bun run start`, the migration
      // container's entrypoint) rather than as Turbo tasks, so turbo.json env
      // declarations cannot describe the PORT and DATABASE_URL they read and
      // noUndeclaredEnvVars has nothing to check them against.
      "includes": ["apps/web/scripts/**", "packages/db/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // The theme contract test runs under `bun test` and loads the CSS
      // fixture through the runtime's `Bun.file` API.
      "includes": ["packages/ui/src/*.test.ts"],
      "javascript": {
        "globals": ["Bun"]
      }
    }
  ]
}
