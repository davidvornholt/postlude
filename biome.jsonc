{
  "$schema": "https://biomejs.dev/schemas/2.5.8/schema.json",
  // Repo-owned wrapper. Extends the canonical strict base synced from
  // davidvornholt/standards. Add project-specific overrides here; never edit
  // biome.base.jsonc locally.
  "extends": ["./biome.base.jsonc"],
  "files": {
    // Claude workflow scripts are a sandboxed DSL dialect (ambient
    // orchestration globals, top-level return) that Biome's ES module
    // parser rejects; the Workflow harness validates them at run time.
    // Claude agent worktrees are full checkouts with their own root
    // biome.jsonc; nested biome.json(c) files are scanner-priority special
    // files, so only force-ignore (`!!`) guarantees they are never discovered
    // as nested roots.
    // routeTree.gen.ts is generated by TanStack Router on every dev/build
    // run and explicitly asks to be excluded from linting and formatting;
    // it cannot conform to the repository style.
    // packages/db/drizzle is drizzle-kit's generated migration output (SQL +
    // meta snapshots); drizzle-kit rewrites it on every `db:generate`, so
    // formatting it would just fight the generator.
    "includes": [
      "**",
      "!.claude/workflows",
      "!!.claude/worktrees",
      "!apps/web/src/routeTree.gen.ts",
      "!packages/db/drizzle"
    ]
  },
  "overrides": [
    {
      // These framework boundaries require default exports as part of their
      // file-based configuration contracts (Vite, Playwright, Drizzle Kit).
      "includes": [
        "apps/web/vite.config.ts",
        "apps/web/playwright.config.ts",
        "packages/db/drizzle.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      // Designated environment boundary: env.ts reads process.env exactly once
      // and validates it. The UPPER_SNAKE keys are the dotenv wire format, not
      // naming choices.
      "includes": ["apps/web/src/shared/env.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off",
            "useNamingConvention": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // drizzle.config.ts runs in drizzle-kit's CLI context (also inside the
      // migration container, where only DATABASE_URL exists) and must not pull
      // the full app env. Its DATABASE_URL read is migrate-runtime-only, never
      // a cached Turbo task input, so it does not belong in turbo.json env
      // declarations.
      "includes": ["packages/db/drizzle.config.ts"],
      "linter": {
        "rules": {
          "correctness": {
            "noProcessGlobal": "off"
          },
          "style": {
            "noProcessEnv": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // TanStack Start server routes: handler keys are the HTTP verbs
      // (GET/POST) and the splat route file must be named `$.ts` — both are
      // framework contracts, not naming choices.
      "includes": ["apps/web/src/routes/api/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      // The private search route owns a server POST handler. Its `POST` key and
      // the `-` prefix that excludes its colocated helper from route generation
      // are TanStack Start contracts, not authored naming choices.
      "includes": [
        "apps/web/src/routes/_app/search.tsx",
        "apps/web/src/routes/_app/-search-request.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      // The TanStack Start document shell renders the literal <head> element;
      // noHeadElement is a Next.js-domain rule and this is not a Next app.
      // Biome's resolver also cannot follow Vite's `?url` asset-query import
      // for the stylesheet; Vite and tsc remain the authoritative resolvers.
      "includes": ["apps/web/src/routes/__root.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          },
          "style": {
            "noHeadElement": "off"
          }
        }
      }
    },
    {
      // The app-owned half of the operational tooling biome.base.jsonc already
      // exempts (root `scripts/**`, packages/a11y-testing,
      // packages/standards-cli), for the path the canonical list cannot name.
      // The production server resolves real paths through `node:fs/promises` to
      // keep a symlink inside dist/client from escaping it, and reports a
      // failed boot through `node:process`; both run only under Bun, never in a
      // browser or on an edge runtime, which is what noNodejsModules protects.
      // The `Bun` global comes from that same runtime (typed via @types/bun).
      // PORT and TMPDIR are handed to the process at launch rather than
      // inherited from a Turbo task: PORT comes from `bun run start` on a
      // deployed host, from `bun --env-file=.env.a11y run start` for the
      // Playwright web server the test:a11y task boots, and from the explicit
      // child env the boot tests spawn servers with; TMPDIR comes from the
      // shell that runs the tests. A turbo.json `env` entry declares the
      // ambient variables a task's cache key depends on, which none of these
      // reads are, so noUndeclaredEnvVars has nothing to check them against.
      "includes": ["apps/web/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // The package-owned half: migrate.ts is the same kind of Bun boundary,
      // minus the Node built-ins. Its DATABASE_URL comes from the migration
      // container's entrypoint, not from a Turbo task's declared env.
      "includes": ["packages/db/scripts/**"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "suspicious": {
            "noUndeclaredEnvVars": "off"
          }
        }
      }
    },
    {
      // Test support modules import `bun:test` to register the hooks the files
      // that call them run under. Biome does not resolve Bun's virtual modules,
      // which is why biome.base.jsonc already turns this rule off for every
      // `*.test.ts` and for the standards CLI's own `*-test-support.ts` files;
      // these are the same modules under the paths this repo puts them on.
      "includes": ["apps/web/src/**/testing/**"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnresolvedImports": "off"
          }
        }
      }
    },
    {
      // Test support: the same boundary biome.base.jsonc already exempts for
      // the standards CLI's `*-test-support.ts` files, for the path this repo
      // puts them on. `test-database.ts` opens the Postgres the database tests
      // run against, so it reads DATABASE_URL from the process the way a test
      // does — it never ships in a bundle and never reaches a browser, which is
      // what noNodejsModules and noProcessEnv protect.
      "includes": ["apps/web/src/shared/testing/**"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "correctness": {
            "noNodejsModules": "off"
          },
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      // TanStack Router spells a dynamic path segment as `$name` in the file
      // name, so the route serving `/day/2026-08-25` can only be called
      // `day.$date.tsx`. The `$` is the framework's routing syntax.
      "includes": ["apps/web/src/routes/**/*.$*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": "off"
          }
        }
      }
    },
    {
      // The written page's classes dress elements no source file writes: the
      // markdown editor creates the heading, the list and the quote at run
      // time, and the class reaches them through a `proseClass` prop and
      // Tiptap's `editorProps.attributes.class` object rather than as a JSX
      // `className` literal. noUnusedClasses only sees literals, so it reports
      // every selector in this file as dead.
      "includes": ["apps/web/src/styles.css"],
      "linter": {
        "rules": {
          "nursery": {
            "noUnusedClasses": "off"
          }
        }
      }
    },
    {
      // One repository boundary's query and transaction coverage against a
      // real Postgres. The shared test support owns resource acquisition and
      // rollback; this file stays ordered by the service methods it protects.
      // See docs/quality/no-excessive-lines-per-file-exceptions.md.
      "includes": [
        "apps/web/src/features/journal/services/entry-repository.test.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noExcessiveLinesPerFile": "off"
          }
        }
      }
    },
    {
      // The theme contract test runs under `bun test` and loads the CSS
      // fixture through the runtime's `Bun.file` API.
      "includes": ["packages/ui/src/*.test.ts"],
      "javascript": {
        "globals": ["Bun"]
      }
    }
  ]
}
