{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["biome.jsonc", "biome.base.jsonc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "check-types": {
      "dependsOn": ["build", "^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "lint:fix": {
      "cache": false,
      "outputs": []
    },
    "test": {
      // The journal repository tests run against a real Postgres. Turbo runs
      // tasks in strict env mode, so a variable the task is not declared to
      // read is not there — undeclared, CI's database would be invisible to
      // exactly the tests that need it.
      "env": ["DATABASE_URL"],
      "outputs": []
    },
    "test:a11y": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
