pt, .swatch.tl-phone { width: 8px; height: 8px; margin: 0; }\n  details.prs { margin: 0; font-size: inherit; color: inherit; }\n  details.prs summary h2 { display: inline; margin: 0 12px 0 0; }\n  ol.arcs { display: flex; flex-direction: column; gap: 18px; margin: 0; padding: 0; list-style: none; }\n  .arc h3 { display: flex; flex-wrap: wrap; gap: 2px 8px; align-items: baseline; margin: 0; font-size: 14px; }\n  .arc .no { display: inline-grid; place-items: center; flex: none; width: 18px; height: 18px; border: 1px solid var(--line); border-radius: 50%; font-size: 11px; font-weight: 400; color: var(--ink-muted); transform: translateY(-1px); }\n  .arc .when { font-size: 12px; font-weight: 400; color: var(--ink-muted); white-space: nowrap; }\n  .arc p { margin: 4px 0 0 26px; max-width: 66ch; }\n  .arc p + p { margin-top: 10px; }\n  dl.facts { display: grid; grid-template-columns: 96px 1fr; gap: 10px 16px; margin: 0; }\n  dl.facts dt { font-weight: 600; font-size: 13px; }\n  dl.facts dd { margin: 0; }\n  dl.facts ul { margin: 0; padding-left: 18px; }\n  dl.facts details { margin-top: 4px; }\n  @media (min-width: 1100px) {\n    .tl-row { grid-template-columns: minmax(80px, 240px) 1fr; }\n    .tl-ticks .minor { display: block; }\n  }\n  @media (max-width: 520px) {\n    dl.facts { grid-template-columns: 1fr; gap: 2px; }\n  }\n  @media (forced-colors: active) {\n    .bar, .split > div, .swatch, .tl-mark { forced-color-adjust: none; border: 1px solid CanvasText; }\n  }\n</style>\n</head>\n<body>\n<main>\n  <header>\n    <p class=\"eyebrow\">Day report</p>\n    <h1 data-metric=\"day\">Waiting for the day's numbers</h1>\n    <p class=\"summary\">A quiet day of reviews and garden work.</p><p class=\"summary\">You started both threads yourself.</p>\n    <p class=\"notice\" data-version-notice hidden></p>\n    \n  </header>\n\n  <section aria-label=\"The day in numbers\" class=\"tiles\">\n    <div class=\"tile\">\n      <p class=\"tile-label\">Screen time</p>\n      <p class=\"ti