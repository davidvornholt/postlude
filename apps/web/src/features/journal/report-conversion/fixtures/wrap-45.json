  "reportHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Day report</title>\n<script>\n  // Until Postlude sends its theme, follow the system setting so the report doesn't flash.\n  document.documentElement.dataset.theme = matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";\n</script>\n<style>\n  /* Surfaces and ink match Postlude's theme. */\n  :root {\n    color-scheme: light;\n    --surface: #f6f1e7;\n    --surface-sunken: #ece7dd;\n    --ink: #2a1f19;\n    --ink-secondary: #5f524b;\n    --ink-muted: #6c615a;\n    --line: #d3cdc3;\n    --focus: #2e8b57;\n    --scattered: #a49d94;\n    --screen: #2e8b57;\n    --agent: #9b8573;\n    --prompt: #2a1f19;\n    --appointment: #4f6fa8;\n    --warning: #fab219;\n    --warning-ink: #0b0b0b;\n    --tooltip-surface: #2a1f19;\n    --tooltip-ink: #f6f1e7;\n  }\n  :root[data-theme=\"dark\"] {\n    color-scheme: dark;\n    --surface: #241b15;\n    --surface-sunken: #1b1410;\n    --ink: #ece7dd;\n    --ink-secondary: #b3ada3;\n    --ink-muted: #a49d94;\n    --line: #453b33;\n    --focus: #2fae78;\n    --scattered: #7d726a;\n    --screen: #2fae78;\n    --agent: #8c7b6d;\n    --prompt: #ece7dd;\n    --appointment: #7f9fd6;\n    --warning: #fab219;\n    --warning-ink: #0b0b0b;\n    --tooltip-surface: #ece7dd;\n    --tooltip-ink: #241b15;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; background: var(--surface); color: var(--ink); }\n  body { font: 15px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; font-variant-numeric: tabular-nums; }\n  /* Every section keeps a column of readable width, and the timeline may use the frame's full width. */\n  main { max-width: 1480px; margin: 0 auto; padding: 24px 20px 32px; }\n  main > * { max-width: 720px; margin-inline: auto; }\n  main > .wide { max-width: none; }\n  h1 { font-size: 22px; line-height: 1.25; font-weight: 600; margin: 0; }\n  h2 { font-size: 15px; font-weight: 600; margin: 0 0 10px; }\n  h3 { font-size: 13px; font-weight: 600; margin: 14px 0 4px; }\n  .eyebrow { margin: 0 0 4px; font-size: 13px; color: var(--ink-muted); }\n  .summary { margin: 12px 0 0; color: var(--ink-secondary); max-width: 62ch; }\n  .notice { margin: 12px 0 0; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; color: var(--ink-secondary); }\n  .alert { display: flex; gap: 10px; align-items: center; margin: 16px 0 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; }\n  .alert p { margin: 0; }\n  .alert-icon { flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--warning); color: var(--warning-ink); font-weight: 700; font-size: 13px; line-height: 20px; text-align: center; }\n  section { margin-top: 28px; }\n  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }\n  .tile { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; }\n  .tile-label { margin: 0; font-size: 13px; color: var(--ink-secondary); }\n  .tile-value { margin: 2px 0 0; font-size: 22px; font-weight: 600; line-height: 1.3; }\n  .tile-note { margin: 4px 0 0; font-size: 12px; color: var(--ink-muted); }\n  .unmeasured { color: var(--ink-muted); font-weight: 400; font-size: 15px; }\n  .tile-note .unmeasured { font-size: inherit; }\n  .estimate { margin-left: 6px; font-size: 12px; font-weight: 400; color: var(--ink-muted); }\n  .split { display: flex; gap: 2px; height: 24px; }\n  .split > div { min-width: 2px; }\n  .split > div:first-child { border-radius: 4px 0 0 4px; }\n  .split > div:last-child { border-radius: 0 4px 4px 0; }\n  .split > div:only-child { border-radius: 4px; }\n  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 8px 0 0; padding: 0;