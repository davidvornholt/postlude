  "reportHtml": "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Day report</title>\n<script>\n  // Until Postlude sends its theme, follow the system setting so the report doesn't flash.\n  document.documentElement.dataset.theme = matchMedia(\"(prefers-color-scheme: dark)\").matches ? \"dark\" : \"light\";\n</script>\n<style>\n  /* Surfaces and ink match Postlude's theme. */\n  :root {\n    color-scheme: light;\n    --surface: #f6f1e7;\n    --surface-sunken: #ece7dd;\n    --ink: #2a1f19;\n    --ink-secondary: #5f524b;\n    --ink-muted: #6c615a;\n    --line: #d3cdc3;\n    --focus: #2e8b57;\n    --scattered: #a49d94;\n    --warning: #fab219;\n    --warning-ink: #0b0b0b;\n    --tooltip-surface: #2a1f19;\n    --tooltip-ink: #f6f1e7;\n  }\n  :root[data-theme=\"dark\"] {\n    color-scheme: dark;\n    --surface: #241b15;\n    --surface-sunken: #1b1410;\n    --ink: #ece7dd;\n    --ink-secondary: #b3ada3;\n    --ink-muted: #a49d94;\n    --line: #453b33;\n    --focus: #2fae78;\n    --scattered: #7d726a;\n    --warning: #fab219;\n    --warning-ink: #0b0b0b;\n    --tooltip-surface: #ece7dd;\n    --tooltip-ink: #241b15;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; background: var(--surface); color: var(--ink); }\n  body { font: 15px/1.5 system-ui, -apple-system, \"Segoe UI\", sans-serif; font-variant-numeric: tabular-nums; }\n  main { max-width: 760px; margin: 0 auto; padding: 24px 20px 32px; }\n  h1 { font-size: 22px; line-height: 1.25; font-weight: 600; margin: 0; }\n  h2 { font-size: 15px; font-weight: 600; margin: 0 0 10px; }\n  .eyebrow { margin: 0 0 4px; font-size: 13px; color: var(--ink-muted); }\n  .summary { margin: 12px 0 0; color: var(--ink-secondary); max-width: 62ch; }\n  .notice { margin: 12px 0 0; padding: 8px 12px; border: 1px solid var(--line); border-radius: 8px; font-size: 13px; color: var(--ink-secondary); }\n  .alert { display: flex; gap: 10px; align-items: center; margin: 16px 0 0; padding: 10px 12px; border: 1px solid var(--line); border-radius: 8px; }\n  .alert p { margin: 0; }\n  .alert-icon { flex: none; width: 20px; height: 20px; border-radius: 50%; background: var(--warning); color: var(--warning-ink); font-weight: 700; font-size: 13px; line-height: 20px; text-align: center; }\n  section { margin-top: 28px; }\n  .tiles { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; }\n  .tile { padding: 12px 14px; border: 1px solid var(--line); border-radius: 10px; }\n  .tile-label { margin: 0; font-size: 13px; color: var(--ink-secondary); }\n  .tile-value { margin: 2px 0 0; font-size: 22px; font-weight: 600; line-height: 1.3; }\n  .tile-note { margin: 4px 0 0; font-size: 12px; color: var(--ink-muted); }\n  .unmeasured { color: var(--ink-muted); font-weight: 400; font-size: 15px; }\n  .tile-note .unmeasured { font-size: inherit; }\n  .estimate { margin-left: 6px; font-size: 12px; font-weight: 400; color: var(--ink-muted); }\n  .split { display: flex; gap: 2px; height: 24px; }\n  .split > div { min-width: 2px; }\n  .split > div:first-child { border-radius: 4px 0 0 4px; }\n  .split > div:last-child { border-radius: 0 4px 4px 0; }\n  .split > div:only-child { border-radius: 4px; }\n  .legend { display: flex; flex-wrap: wrap; gap: 6px 18px; margin: 8px 0 0; padding: 0; list-style: none; font-size: 13px; color: var(--ink-secondary); }\n  .legend li { display: flex; align-items: center; gap: 6px; }\n  .swatch { width: 10px; height: 10px; border-radius: 2px; flex: none; }\n  .bars { display: grid; grid-template-columns: minmax(96px, 180px) 1fr auto; gap: 6px 10px; align-items: center; font-size: 13px; }\n  .bar-label { color: var(--ink-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  .bar-track { position: relative; height: 16px; border-left: 1px solid var(--line); }\n  .bar { height: 16px; background: var(--focus); border-radius: 0 4px 4px 0; min-width: 2px; }\n  .bar-value { color: var(--ink-secondary); text-align: right; white-space: nowrap; }\n  [data-tip] { cursor: default; }\n  [data-tip]:focus-visible { outline: 2px solid var(--ink); outline-offset: 2px; }\n  details { margin-top: 10px; font-size: 13px; color: var(--ink-secondary); }\n  summary { cursor: pointer; }\n  table { border-collapse: collapse; margin-top: 6px; }\n  th, td { padding: 3px 16px 3px 0; text-align: left; border-bottom: 1px solid var(--line); font-weight: 400; }\n  td.number { text-align: right; padding-right: 0; }\n  ul.items { margin: 0; padding: 0; list-style: none; }\n  ul.items li { padding: 6px 0; border-bottom: 1px solid var(--line); }\n  ul.items li:last-child { border-bottom: none; }\n  .meta { color: var(--ink-muted); font-size: 13px; }\n  .time { padding-right: 12px; color: var(--ink-secondary); }\n  .empty { margin: 0; color: var(--ink-muted); font-size: 13px; }\n  .tooltip { position: fixed; z-index: 1; pointer-events: none; padding: 4px 8px; border-radius: 6px; background: var(--tooltip-surface); color: var(--tooltip-ink); font-size: 12px; white-space: nowrap; }\n  @media (forced-colors: active) {\n    .bar, .split > div, .swatch { forced-color-adjust: none; border: 1px solid CanvasText; }\n  }\n</style>\n</head>\n<body>\n<main>\n  <header>\n    <p class=\"eyebrow\">Day report</p>\n    <h1 data-metric=\"day\">Waiting for the day's numbers</h1>\n    <p class=\"summary\">A quiet day of reviews and garden work.</p>\n    <p class=\"notice\" data-version-notice hidden></p>\n    \n  </header>\n\n  <section aria-label=\"The day in numbers\" class=\"tiles\">\n    <div class=\"tile\">\n      <p class=\"tile-label\">Screen time</p>\n      <p class=\"tile-value\" data-metric=\"activeMinutes\"></p>\n      <p class=\"tile-note\">From <span data-metric=\"firstActivityAt\"></span> to <span data-metric=\"lastActivityAt\"></span></p>\n    </div>\n    <div class=\"tile\">\n      <p class=\"tile-label\">Focus</p>\n      <p class=\"tile-value\" data-metric=\"focusMinutes\"></p>\n      <p class=\"tile-note\">Scattered: <span data-metric=\"scatteredMinutes\"></span></p>\n    </div>\n    <div class=\"tile\">\n      <p class=\"tile-label\">Off the computer</p>\n      <p class=\"tile-value\" data-metric=\"offComputerMinutes\"></p>\n      <p class=\"tile-note\">Tracked in Super Productivity</p>\n    </div>\n    <div class=\"tile\">\n      <p class=\"tile-label\">Appointments</p>\n      <p class=\"tile-value\" data-metric=\"appointmentMinutes\"></p>\n      <p class=\"tile-note\">Away from the screen: <span data-metric=\"appointmentOffScreenMinutes\"></span></p>\n    </div>\n    <div class=\"tile\">\n      <p class=\"tile-label\">Landed pull requests</p>\n      <p class=\"tile-value\" data-metric=\"landedPrs\"></p>\n    </div>\n    <div class=\"tile\">\n      <p class=\"tile-label\">Sent mail</p>\n      <p class=\"tile-value\" data-metric=\"sentMails\" data-view=\"total\"></p>\n      <p class=\"tile-note\" data-metric=\"sentMails\" data-view=\"note\"></p>\n    </div>\n  </section>\n\n  <section>\n    <h2>Focus and scattered time</h2>\n    <div class=\"split\" data-metric=\"focusMinutes\" data-view=\"split\"></div>\n    <ul class=\"legend\">\n      <li><span class=\"swatch\" style=\"background: var(--focus)\"></span>Focus <span data-metric=\"focusMinutes\"></span></li>\n      <li><span class=\"swatch\" style=\"background: var(--scattered)\"></span>Scattered <span data-metric=\"scatteredMinutes\"></span></li>\n    </ul>\n  </section>\n\n  <section>\n    <h2>Time by category <span class=\"estimate\">estimates</span></h2>\n    <div class=\"bars\" data-metric=\"categories\" data-view=\"bars\"></div>\n    <details>\n      <summary>Show as a table</summary>\n      <table>\n        <thead><tr><th scope=\"col\">Category</th><th scope=\"col\">Time</th></tr></thead>\n        <tbody data-metric=\"categories\" data-view=\"table\"></tbody>\n      </table>\n    </details>\n  </section>\n\n  <section>\n    <h2>Sent mail by mailbox</h2>\n    <ul class=\"items\" data-metric=\"sentMails\" data-view=\"list\"></ul>\n  </section>\n\n  <section><h2>Appointments</h2><ul class=\"items\"><li><span class=\"time\">All day</span>Holiday</li><li>Standup</li><li>Review</li><li>Lunch</li><li>Night train</li></ul></section>\n  <section><h2>Tasks checked off</h2><ul class=\"items\"><li>Write tests <span class=\"meta\">· Work</span></li><li>Garden › Dig <span class=\"meta\">· Home</span></li><li>Shop <span class=\"meta\">· Home</span></li></ul></section>\n  <section><h2>Threads settled</h2><ul class=\"items\"><li>Settled today <span class=\"meta\">· postlude</span></li></ul></section>\n  <section><h2>Pull requests landed</h2><ul class=\"items\"><li>Start of day <span class=\"meta\">· example/postlude</span></li><li>Afternoon <span class=\"meta\">· example/sp-cli</span></li></ul></section>\n  <section><h2>Threads open for several days</h2><ul class=\"items\"><li>Settled later <span class=\"meta\">· nix-config</span></li><li>Long open <span class=\"meta\">· dev</span></li></ul></section>\n\n  <section>\n    <h2>Sources</h2>\n    <ul class=\"items\" data-metric=\"coverage\" data-view=\"list\"></ul>\n    <p class=\"meta\">Kontor's bank status was not available.</p>\n  </section>\n</main>\n<div class=\"tooltip\" role=\"tooltip\" hidden></div>\n<script>\n  const METRICS_VERSION = 1;\n  const clock = new Intl.DateTimeFormat(\"en-GB\", { timeZone: \"Europe/Berlin\", hour: \"2-digit\", minute: \"2-digit\", hourCycle: \"h23\" });\n  const longDate = new Intl.DateTimeFormat(\"en-GB\", { timeZone: \"UTC\", weekday: \"long\", day: \"numeric\", month: \"long\", year: \"numeric\" });\n  const sourceNames = { activity: \"Screen activity\", sp: \"Super Productivity\", github: \"GitHub\", mail: \"Mail\", calendar: \"Calendar\" };\n  const statusNames = { partial: \"partly available\", missing: \"not available\" };\n\n  const minutesText = (minutes) => {\n    const whole = Math.round(minutes);\n    const hours = Math.floor(whole / 60);\n    const rest = whole % 60;\n    if (hours === 0) return `${rest} min`;\n    return rest === 0 ? `${hours} h` : `${hours} h ${rest} min`;\n  };\n  const isNumber = (value) => typeof value === \"number\" && Number.isFinite(value);\n  const element = (tag, className, text) => {\n    const node = document.createElement(tag);\n    if (className) node.className = className;\n    if (text !== undefined) node.textContent = text;\n    return node;\n  };\n  const showUnmeasured = (node) => node.replaceChildren(element(\"span\", \"unmeasured\", \"Not measured\"));\n  const show = (node, text) => {\n    if (text === null) showUnmeasured(node);\n    else node.textContent = text;\n  };\n  const each = (key, view, fill) => {\n    const selector = view ? `[data-metric=\"${key}\"][data-view=\"${view}\"]` : `[data-metric=\"${key}\"]:not([data-view])`;\n    for (const node of document.querySelectorAll(selector)) fill(node);\n  };\n  const tip = (node, text) => {\n    node.dataset.tip = text;\n    node.tabIndex = 0;\n    node.setAttribute(\"aria-label\", text);\n  };\n\n  const fillMinutes = (metrics, key) =>\n    each(key, null, (node) => show(node, isNumber(metrics[key]) ? minutesText(metrics[key]) : null));\n  const fillClock = (metrics, key) =>\n    each(key, null, (node) => {\n      const ms = typeof metrics[key] === \"string\" ? Date.parse(metrics[key]) : Number.NaN;\n      node.textContent = Number.isNaN(ms) ? \"–\" : clock.format(ms);\n    });\n  const fillCount = (metrics, key) =>\n    each(key, null, (node) => show(node, isNumber(metrics[key]) ? String(metrics[key]) : null));\n\n  const fillSplit = (metrics) =>\n    each(\"focusMinutes\", \"split\", (node) => {\n      node.replaceChildren();\n      const { focusMinutes: focus, scatteredMinutes: scattered } = metrics;\n      if (!isNumber(focus) || !isNumber(scattered) || focus + scattered === 0) {\n        node.append(element(\"p\", \"empty\", isNumber(focus) && isNumber(scattered) ? \"No screen time.\" : \"Not measured.\"));\n        return;\n      }\n      const total = focus + scattered;\n      for (const [label, minutes, color] of [[\"Focus\", focus, \"var(--focus)\"], [\"Scattered\", scattered, \"var(--scattered)\"]]) {\n        if (minutes === 0) continue;\n        const segment = element(\"div\");\n        segment.style.flex = `${minutes} 0 0`;\n        segment.style.background = color;\n        tip(segment, `${label}: ${minutesText(minutes)}, ${Math.round((minutes / total) * 100)}% of screen time`);\n        node.append(segment);\n      }\n    });\n\n  const fillCategories = (metrics) => {\n    const categories = Array.isArray(metrics.categories) ? metrics.categories.filter((category) => isNumber(category.minutes)) : [];\n    const largest = Math.max(0, ...categories.map((category) => category.minutes));\n    each(\"categories\", \"bars\", (node) => {\n      node.replaceChildren();\n      if (categories.length === 0) {\n        node.append(element(\"p\", \"empty\", \"No categories measured.\"));\n        return;\n      }\n      for (const category of categories) {\n        const track = element(\"div\", \"bar-track\");\n        const bar = element(\"div\", \"bar\");\n        bar.style.width = `${largest === 0 ? 0 : (category.minutes / largest) * 100}%`;\n        const share = isNumber(metrics.activeMinutes) && metrics.activeMinutes > 0 ? `, ${Math.round((category.minutes / metrics.activeMinutes) * 100)}% of screen time` : \"\";\n        tip(bar, `${category.label}: ${minutesText(category.minutes)}${share} (estimate)`);\n        track.append(bar);\n        node.append(element(\"div\", \"bar-label\", category.label), track, element(\"div\", \"bar-value\", minutesText(category.minutes)));\n      }\n    });\n    each(\"categories\", \"table\", (node) =>\n      node.replaceChildren(\n        ...categories.map((category) => {\n          const label = element(\"th\", \"\", category.label);\n          label.scope = \"row\";\n          const row = element(\"tr\");\n          row.append(label, element(\"td\", \"number\", minutesText(category.minutes)));\n          return row;\n        }),\n      ),\n    );\n  };\n\n  const fillSentMails = (metrics) => {\n    const mailboxes = Array.isArray(metrics.sentMails) ? metrics.sentMails : [];\n    const counted = mailboxes.filter((mailbox) => isNumber(mailbox.count));\n    each(\"sentMails\", \"total\", (node) =>\n      show(node, counted.length === 0 ? null : String(counted.reduce((sum, mailbox) => sum + mailbox.count, 0))),\n    );\n    each(\"sentMails\", \"note\", (node) => {\n      node.textContent = counted.length < mailboxes.length ? \"Without the mailboxes that weren't measured\" : \"Across all mailboxes\";\n    });\n    each(\"sentMails\", \"list\", (node) => {\n      const shown = mailboxes.filter((mailbox) => !isNumber(mailbox.count) || mailbox.count > 0);\n      if (shown.length === 0) {\n        node.replaceChildren(element(\"li\", \"meta\", mailboxes.length === 0 ? \"Not measured.\" : \"No mail sent.\"));\n        return;\n      }\n      node.replaceChildren(\n        ...shown.map((mailbox) => {\n          const item = element(\"li\", \"\", `${mailbox.mailbox}: `);\n          item.append(isNumber(mailbox.count) ? String(mailbox.count) : element(\"span\", \"unmeasured\", \"Not measured\"));\n          return item;\n        }),\n      );\n    });\n  };\n\n  const fillCoverage = (metrics) =>\n    each(\"coverage\", \"list\", (node) => {\n      const gaps = (Array.isArray(metrics.coverage) ? metrics.coverage : []).filter((entry) => entry.status !== \"complete\");\n      if (gaps.length === 0) {\n        node.replaceChildren(element(\"li\", \"meta\", \"Every measured source was complete.\"));\n        return;\n      }\n      node.replaceChildren(\n        ...gaps.map((entry) => {\n          const [kind, ...rest] = String(entry.source).split(\":\");\n          const detail = rest.join(\":\");\n          const name = `${sourceNames[kind] ?? kind}${detail ? ` (${detail})` : \"\"}`;\n          return element(\"li\", \"\", `${name}: ${statusNames[entry.status] ?? entry.status}`);\n        }),\n      );\n    });\n\n  const fill = (metricsVersion, metrics) => {\n    const notice = document.querySelector(\"[data-version-notice]\");\n    const version = metrics.metricsVersion ?? metricsVersion;\n    notice.hidden = version === METRICS_VERSION;\n    notice.textContent = \"These numbers come from a different metrics version than this report was built for, so some may be missing. Running /wrap again for this day rebuilds it.\";\n    each(\"day\", null, (node) => {\n      const ms = Date.parse(`${metrics.day}T12:00:00Z`);\n      if (!Number.isNaN(ms)) node.textContent = longDate.format(ms);\n    });\n    for (const key of [\"activeMinutes\", \"focusMinutes\", \"scatteredMinutes\", \"offComputerMinutes\", \"appointmentMinutes\", \"appointmentOffScreenMinutes\"]) fillMinutes(metrics, key);\n    for (const key of [\"firstActivityAt\", \"lastActivityAt\"]) fillClock(metrics, key);\n    fillCount(metrics, \"landedPrs\");\n    fillSplit(metrics);\n    fillCategories(metrics);\n    fillSentMails(metrics);\n    fillCoverage(metrics);\n  };\n\n  const postHeight = () => {\n    window.parent.postMessage({ type: \"postlude:report-height\", height: Math.ceil(document.body.getBoundingClientRect().height) }, \"*\");\n  };\n\n  window.addEventListener(\"message\", (event) => {\n    if (event.source !== window.parent) return;\n    const data = event.data;\n    if (typeof data !== \"object\" || data === null || data.type !== \"postlude:day-metrics\") return;\n    if (typeof data.dayMetrics !== \"object\" || data.dayMetrics === null) return;\n    document.documentElement.dataset.theme = data.theme === \"dark\" ? \"dark\" : \"light\";\n    fill(data.metricsVersion, data.dayMetrics);\n    postHeight();\n  });\n\n  const tooltip = document.querySelector(\".tooltip\");\n  const place = (target, x, y) => {\n    tooltip.textContent = target.dataset.tip;\n    tooltip.hidden = false;\n    const width = tooltip.offsetWidth;\n    tooltip.style.left = `${Math.max(4, Math.min(x + 12, window.innerWidth - width - 4))}px`;\n    tooltip.style.top = `${Math.max(4, y - 34)}px`;\n  };\n  document.addEventListener(\"pointermove\", (event) => {\n    const target = event.target instanceof Element ? event.target.closest(\"[data-tip]\") : null;\n    if (target) place(target, event.clientX, event.clientY);\n    else tooltip.hidden = true;\n  });\n  document.addEventListener(\"focusin\", (event) => {\n    const target = event.target instanceof Element ? event.target.closest(\"[data-tip]\") : null;\n    if (!target) return;\n    const box = target.getBoundingClientRect();\n    place(target, box.left, box.top);\n  });\n  const hideTooltip = () => {\n    tooltip.hidden = true;\n  };\n  document.addEventListener(\"focusout\", hideTooltip);\n  document.addEventListener(\"pointerleave\", hideTooltip);\n\n  new ResizeObserver(postHeight).observe(document.body);\n</script>\n</body>\n</html>\n"
}
