# A11y fixture, NO secrets: the Playwright web server boots with this; the
# scanned pages (unauthenticated surface) touch neither database nor OAuth.
# These fixture values are what the server uses in CI too: the a11y task runs
# under Turbo's strict env mode and no task declares env or passThroughEnv, so
# the workflow's job-level DATABASE_URL is stripped before the server starts.
# The scan stays green because session reads fail closed and the scanned routes
# never reach the database. PORT 3100 keeps the scan clear of dev servers and
# other local listeners on 3000.
PORT=3100
DATABASE_URL=postgresql://a11y:a11y@127.0.0.1:15433/a11y_fixture
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=a11y-fixture-not-a-secret-0123456789012345
GITHUB_CLIENT_ID=a11y-fixture-client-id
GITHUB_CLIENT_SECRET=a11y-fixture-client-secret
GITHUB_ALLOWED_ACCOUNT_ID=157214705
