# A11y fixture, NO secrets: the Playwright web server boots with this; the
# scanned pages (unauthenticated surface) touch neither database nor OAuth. The
# scan stays green because session reads fail closed and the scanned routes
# never reach the database.
# Precedence: `bun --env-file` only fills in keys the process environment has
# not set already, so on a direct `bun run test:a11y` an exported DATABASE_URL —
# or any other key below — wins over this file. Under `turbo run test:a11y` the
# task runs in strict env mode and declares neither env nor passThroughEnv, so
# undeclared variables (a CI job's DATABASE_URL among them) are stripped before
# the server starts and these values are the ones it uses.
# PORT 3100 keeps the scan clear of dev servers and other local listeners
# on 3000.
PORT=3100
DATABASE_URL=postgresql://a11y:a11y@127.0.0.1:15433/a11y_fixture
BETTER_AUTH_URL=http://127.0.0.1:3100
BETTER_AUTH_SECRET=a11y-fixture-not-a-secret-0123456789012345
GITHUB_CLIENT_ID=a11y-fixture-client-id
GITHUB_CLIENT_SECRET=a11y-fixture-client-secret
GITHUB_ALLOWED_ACCOUNT_ID=157214705
