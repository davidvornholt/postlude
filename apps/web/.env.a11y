# A11y fixture, NO secrets: the Playwright web server boots with this; the
# scanned pages (unauthenticated surface) touch neither database nor OAuth.
# In CI the workflow supplies a real DATABASE_URL; existing process
# environment variables take precedence over this file. PORT 3100 keeps the
# scan clear of dev servers and other local listeners on 3000.
PORT=3100
DATABASE_URL=postgresql://a11y:a11y@127.0.0.1:15433/a11y_fixture
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=a11y-fixture-not-a-secret-0123456789012345
GITHUB_CLIENT_ID=a11y-fixture-client-id
GITHUB_CLIENT_SECRET=a11y-fixture-client-secret
GITHUB_ALLOWED_ACCOUNT_ID=157214705
