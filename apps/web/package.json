{
  "name": "@postlude/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && bun run scripts/check-server-imports.ts",
    "start": "bun run scripts/serve.ts",
    "db:migrate": "bun --env-file=.env.local run scripts/migrate.ts",
    "db:migrate:deploy": "bun run scripts/migrate.ts",
    "db:seed:preview": "bun run scripts/seed-preview.ts",
    "import:journals": "bun run scripts/import-journals.ts",
    "cli": "bun scripts/cli.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "test:a11y": "playwright test --config playwright.config.ts",
    "benchmark:search": "bun scripts/benchmark-search.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@effect/sql-pg": "^4.1.2",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@postlude/db": "workspace:*",
    "@postlude/ui": "workspace:*",
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.169.5",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-image": "3.33.0",
    "@tiptap/extension-list": "^3.33.0",
    "@tiptap/extension-table": "3.33.0",
    "@tiptap/markdown": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.2",
    "fflate": "^0.8.3",
    "lucide-react": "^1.70.0",
    "marked": "18.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^7.29.9",
    "@davidvornholt/a11y-testing": "workspace:*",
    "@davidvornholt/typescript-config": "workspace:*",
    "@playwright/test": "1.65.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  }
}
